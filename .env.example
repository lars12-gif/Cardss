# Required: WhatsApp number used to link the bot, international digits only.
# Example Iraq: 9647XXXXXXXXX (do not include + or spaces)
BOT_NUMBER=9647XXXXXXXXX

# Default country calling code for vCards that contain local numbers without +.
# Used only when the vCard has no international country code.
DEFAULT_COUNTRY_CODE=964

# Restrict bot commands/collection to group chats only: true or false
GROUPS_ONLY=false

# Optional: only this WhatsApp account can operate the bot.
# Use full international digits without +, e.g. 9647XXXXXXXXX
# Leave empty to allow any participant to use commands in the chat.
OWNER_NUMBER=

# JSON persistence location
DATA_FILE=./data/collections.json

# Log level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info
