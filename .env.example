# رقم واتساب الذي تريد ربط البوت به، مع رمز الدولة وبدون + أو مسافات
BOT_NUMBER=9647XXXXXXXXX

# رمز الدولة الافتراضي للأرقام المحلية التي لا تحتوي على رمز دولة
DEFAULT_COUNTRY_CODE=964

# الحد الأعلى لبطاقات جهات الاتصال التي يجمعها البوت لكل محادثة
MAX_CONTACTS=500

# مستوى السجل: silent أو error أو warn أو info أو debug
LOG_LEVEL=info
